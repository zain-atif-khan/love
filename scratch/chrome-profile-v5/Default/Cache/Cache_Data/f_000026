    // -------------------------------------------------------------
    // THE STANDING GIRL (partType = 4)
    // Delicate blush pink, luminous petal pink, ethereal highlights
    // -------------------------------------------------------------
    vec3 petalPink     = vec3(0.99, 0.64, 0.80); // #fda3cc
    vec3 etherealBlush = vec3(0.98, 0.80, 0.90); // #facce6
    vec3 lavenderHint  = vec3(0.90, 0.74, 0.97); // #e6bcf7
    color = mix(petalPink, etherealBlush, vColorT);
