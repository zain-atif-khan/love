    vec3 wineRed    = vec3(0.58, 0.06, 0.16); // #940f29
    vec3 stemAccent = vec3(0.85, 0.35, 0.48); // #d9597a
    color = mix(deepGarnet, wineRed, vColorT);
    if (vRandom > 0.75) {
      color = mix(color, stemAccent, 0.4);
    }
  } else if (vPartType < 2.5) {
    // -------------------------------------------------------------
    // THE HAND WRAPPING THE STEM (partType = 2)
    // Soft blush pink with warm white highlights
    // -------------------------------------------------------------
    vec3 blushPink = vec3(0.96, 0.50, 0.69); // #f580b0
    vec3 warmWhite = vec3(1.0, 0.94, 0.96);
    color = mix(blushPink, warmWhite, vColorT * 0.38);
  } else if (vPartType < 3.5) {
    // -------------------------------------------------------------
    // THE KNEELING PERSON (MAN) (partType = 3)
    // Blush pink, soft rose, dusty pink, subtle lavender
    // -------------------------------------------------------------
    vec3 dustyRose  = vec3(0.92, 0.44, 0.60); // #eb7099
    vec3 softBlush  = vec3(0.98, 0.60, 0.78); // #fa9ac7
    vec3 paleAccent = vec3(0.88, 0.70, 0.96); // Subtle lavender
    color = mix(dustyRose, softBlush, vColorT);
    if (vRandom > 0.80) {
      color = mix(color, paleAccent, 0.35);
    }
