    // AMBIENT DRIFTING STARDUST (partType = 5)
    // -------------------------------------------------------------
    vec3 ambientPink = vec3(0.98, 0.68, 0.84);
    vec3 ambientGlow = vec3(0.95, 0.85, 0.98);
